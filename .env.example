# Discord bot token (Developer Portal -> Bot -> Reset Token). Keep secret.
DISCORD_TOKEN=
# Discord application (client) ID, used to register slash commands globally.
DISCORD_CLIENT_ID=
# Where reports go: comma-separated guildId:channelId pairs, one per server.
REPORT_CHANNELS=111111111111111111:222222222222222222
# IANA timezone used for dates and times shown in reports.
TIMEZONE=Asia/Dhaka
# Where meeting audio and meta.json are stored.
RECORDINGS_DIR=./recordings
# Gemini API key (free tier): primary transcription and summary.
GEMINI_API_KEY=
# Gemini model used for transcription and summary.
GEMINI_MODEL=gemini-3.5-flash
# Optional Groq API key: enables the backup transcriber and backup summarizer.
GROQ_API_KEY=
# Groq transcription model (backup transcriber).
GROQ_MODEL=whisper-large-v3
# Groq model used for the backup summary.
GROQ_SUMMARY_MODEL=openai/gpt-oss-120b
# Primary transcriber: gemini or groq (groq requires GROQ_API_KEY).
TRANSCRIBER=gemini
